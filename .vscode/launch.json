{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: run.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/reliefline/run.py",
            "cwd": "${workspaceFolder}/reliefline",
            "python": "${workspaceFolder}/reliefline/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "jinja": true
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
